# Samsung Galaxy Z Fold 5 — Termux SSH, then Fold-local wireless ADB.
# Pairing identity lives on the phone. Do not delete Termux ~/.android keys.
ADEV_PROFILE_NAME=fold
ADEV_SSH_HOST="${ADEV_SSH_HOST:-fold}"
ADEV_TRANSPORT=fold-ssh-termux-adb
ADEV_ADB_WIFI_TIMEOUT_S="${ADEV_ADB_WIFI_TIMEOUT_S:-180}"
ADEV_SETTLE_S="${ADEV_SETTLE_S:-12}"
# Companion package on this device.
ADEV_APP_PACKAGE="${ADEV_APP_PACKAGE:-dev.notune.transcribe}"
ADEV_HELIBOARD_PACKAGE="${ADEV_HELIBOARD_PACKAGE:-helium314.keyboard}"
