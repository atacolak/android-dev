# Pin file for android-dev bootstrap/doctor. Sourced by scripts.
# Tool *binaries* are not in git; only versions and checksums.

ADEV_JDK_MAJOR=17
ADEV_JDK_VENDOR=temurin
ADEV_JDK_RELEASE=17.0.16_8
# Adoptium API fallback when the pinned tarball URL is used.
ADEV_JDK_API="https://api.adoptium.net/v3/binary/version/jdk-17.0.16+8/linux/x64/jdk/hotspot/normal/eclipse?project=jdk"

ADEV_COMPILE_SDK=35
ADEV_BUILD_TOOLS=35.0.0
ADEV_NDK=28.0.13004108
ADEV_CMDLINE_TOOLS=11076708
ADEV_CMDLINE_TOOLS_ZIP="https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"

ADEV_RUST_TARGET=aarch64-linux-android
ADEV_CARGO_NDK=4.1.2
ADEV_CMAKE_MIN=3.22

# Companion app (not part of this repo).
ADEV_APP_REPO=https://github.com/atacolak/android-transcribe.git
ADEV_APP_UPSTREAM=https://github.com/notune/android_transcribe_app.git
ADEV_APP_PACKAGE=dev.notune.transcribe
